[Unit]
Description=Review open pull requests through persona reviewers
After=network-online.target

[Service]
Type=oneshot
# pr-reviewer.sh takes its own flock (self-exec'd), so a slow tick makes the
# next one skip rather than stack, regardless of how the script is invoked.
ExecStart=%h/git/PR-Reviewer/pr-reviewer.sh
WorkingDirectory=%h/git/PR-Reviewer
Environment=MAX_PRS_PER_TICK=5
# HANDOFF_URL and HANDOFF_TOKEN for the hand-off board, if you post findings
# there. Optional (leading '-'): the tick falls back to a local report file.
# Keep it mode 600; it holds a bearer token.
EnvironmentFile=-%h/.config/pr-reviewer/env
