# Copy to .env (mode 600). The GitHub login is not here: see README, Docker.
MODEL_GATEWAY=https://gateway.example
MODEL_GATEWAY_KEY=
SECURITY_SKILL_DIR=/home/you/.codex/skills/security-audit
# Optional
HANDOFF_URL=
HANDOFF_TOKEN=
REPOSITORIES=
EXCLUDE_REPOSITORIES=
PR_AGENT_MODEL=claude-sonnet-5-5
# 1 also posts pr-agent's advisory on public repositories.
PR_AGENT_PUBLIC=
# Where the status page listens. Default is this machine only; it shows pull
# request titles without a login, so open it to a trusted network only.
DASHBOARD_BIND=127.0.0.1:8091
